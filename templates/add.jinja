<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Programming in Python</title>
    <style>
        h1 {
            text-align: center;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        table, th, td {
            border: 1px solid black;
        }
        th, td {
            padding: 15px;
            text-align: center;
        }
        th {
            background-color: #f2f2f2;
        }
        div {
            border : 1px solid black;
        }
    </style>
</head>
<body>
    <div><h1>Add record</h1></div>
    <form action="add" method="post">
        <table>
            <tr><td>Sex</td><td><input type="text" id="sex", name="sex"></td></tr>
            <tr><td>Length</td><td><input type="text" id="length", name="length"></td></tr>
            <tr><td>Diameter</td><td><input type="text" id="diameter", name="diameter"></td></tr>
            <tr><td>Height</td><td><input type="text" id="height", name="height"></td></tr>
            <tr><td>Whole weight</td><td><input type="text" id="whole_weight", name="whole_weight"></td></tr>
            <tr><td>Shucked weight</td><td><input type="text" id="shucked_weight", name="shucked_weight"></td></tr>
            <tr><td>Viscera weight</td><td><input type="text" id="viscera_weight", name="viscera_weight"></td></tr>
            <tr><td>Shell weight</td><td><input type="text" id="shell_weight", name="shell_weight"></td></tr>
            <tr><td>Rings</td><td><input type="text" id="rings", name="rings"></td></tr>
        </table>
        <input type="submit" value="Add">
    </form>
</body>
</html>