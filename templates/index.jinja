<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Programming in Python</title>
    <style>
        h1 {
            text-align: center;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        table, th, td {
            border: 1px solid black;
        }
        th, td {
            padding: 15px;
            text-align: center;
        }
        th {
            background-color: #f2f2f2;
        }
        div {
            border : 1px solid black;
        }
    </style>
</head>
<body>
    <div><h1><a href="add">Add record</a></h1></div>
    <div><h1>All data</h1><br>
        <table>
            <tr>
                <th>Id</th>
                <th>Sex</th>
                <th>Length</th>
                <th>Diameter</th>
                <th>Rings</th>
                <th>Action</th>
            </tr>
            {% for row in rows %}
            <tr>
                <td>{{ row.id }}</td>
                <td>{{ row.sex }}</td>
                <td>{{ row.length }}</td>
                <td>{{ row.diameter }}</td>
                <td>{{ row.rings }}</td>
                <td><a href="delete/{{ row.id }}">Delete</a></td>
            </tr>
            {%endfor%}

        </table>

    </div>
</body>
</html>