<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Programming in Python</title>
    <style>
        h1 {
            text-align: center;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        table, th, td {
            border: 1px solid black;
        }
        th, td {
            padding: 15px;
            text-align: center;
        }
        th {
            background-color: #f2f2f2;
        }
        div {
            border : 1px solid black;
        }
    </style>
</head>
<body>
    <div><h1><a href="add">Add record</a></h1></div>
    <div><h1>All data</h1><br>
        <table>
            <tr>
                <th>Id</th>
                <th>Sex</th>
                <th>Length</th>
                <th>Diameter</th>
                <th>Height</th>
                <th>Whole weight</th>
                <th>Shucked weight</th>
                <th>Viscera weight</th>
                <th>Shell weight</th>
                <th>Rings</th>
                <th>Action</th>
            </tr>
            {% for row in rows %}
            <tr>
                <td>{{ row[0] }}</td>
                <td>{{ row[1] }}</td>
                <td>{{ row[2] }}</td>
                <td>{{ row[3] }}</td>
                <td>{{ row[4] }}</td>
                <td>{{ row[5] }}</td>
                <td>{{ row[6] }}</td>
                <td>{{ row[7] }}</td>
                <td>{{ row[8] }}</td>
                <td>{{ row[9] }}</td>
                <td><a href="delete/{{ row[0] }}">Delete</a></td>
            </tr>
            {%endfor%}

        </table>

    </div>
</body>
</html>